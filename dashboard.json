          },
          "pluginVersion": "4.10.2",
          "queryType": "table",
          "rawSql": "SELECT\n    today.day AS day,\n    countIf(prev_active = 1 AND today_active = 0) AS churned_users\nFROM\n(\n    SELECT\n        user_id,\n        toStartOfDay(timestamp) AS day,\n        1 AS today_active\n    FROM logs_database.logs\n    WHERE is_authenticated = 1\n) AS today\nANY LEFT JOIN\n(\n    SELECT\n        user_id,\n        toStartOfDay(timestamp) AS day,\n        1 AS prev_active\n    FROM logs_database.logs\n    WHERE is_authenticated = 1\n) AS yesterday\nON today.user_id = yesterday.user_id AND today.day = yesterday.day + 1\nGROUP BY day\nORDER BY day",
          "refId": "A"
        }
      ],
      "title": "User Churn",
      "type": "timeseries"
    },
